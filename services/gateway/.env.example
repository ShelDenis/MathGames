# Gateway занимает порт, на который уже ходит фронтенд, поэтому фронтенд менять не нужно
PORT=3001

# Тот же секрет, что у Auth Service и Core
JWT_SECRET=change-me-to-a-long-random-string

# Куда проксировать
AUTH_URL=http://localhost:3002

# Core Service. Можно несколько через запятую: Gateway раздаёт запросы по кругу.
# Пока Core Service не готов, здесь старый монолит (backend), запущенный на порту 3003.
CORE_URLS=http://localhost:3003

# Image Worker (загрузка фото, /uploads, Socket.IO). Тоже можно несколько адресов,
# но Socket.IO всегда идёт на первый (для нескольких понадобятся sticky sessions).
# Пока Image Worker не готов, тоже указываем монолит.
IMAGE_WORKER_URLS=http://localhost:3003

# Какие сайты фронтенда могут обращаться к API (через запятую или *)
CORS_ORIGIN=*
