# Порт Auth Service
PORT=3002

# Отдельная БД только для пользователей (Prisma создаст её сам при db:push)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mathgames_auth"

# ВАЖНО: одинаковый секрет у Auth, Gateway и Core (монолита/Core Service)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# true  - как раньше: при регистрации можно выбрать любую роль
# false - любую роль, кроме STUDENT, может выдать только ADMIN (по токену)
ALLOW_ROLE_SELECTION=true

# Для npm run seed: первый администратор
ADMIN_EMAIL=admin@mathgames.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Администратор
