# Скопируйте в backend/.env (сам .env в git не попадает, у каждого он свой)

# Строка подключения к вашему локальному Postgres (БД монолита / будущего Core)
DATABASE_URL="postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/mathgames"

# ДОЛЖЕН совпадать с JWT_SECRET в services/auth/.env и services/gateway/.env.
# Иначе монолит не примет токены, выданные Auth Service.
JWT_SECRET=change-me-to-a-long-random-string

# Порт 3001 теперь занимает API Gateway, монолит (пока он играет роль Core) уходит на 3003
PORT=3003
